# ==============================================================================
# DBC Abhista Environment Configuration Template
# Copy this file to `.env.local` for local development
# NEVER put real secret keys directly inside source code or commit `.env.local`
# ==============================================================================

# Firebase Web App Configuration (From Firebase Console -> Project Settings -> Web App)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Database Connection (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgresql://user:password@localhost:5432/dbc_db
DIRECT_URL=postgresql://user:password@localhost:5432/dbc_db

# JWT Auth Secret Key
JWT_SECRET=dbc_super_secret_jwt_key_2026
