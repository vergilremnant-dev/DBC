datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentType {
  SUBSCRIPTION
  LISTING_FEE
  BOOKING
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}


model User {
  id                  String             @id @default(uuid())
  email               String             @unique
  password            String
  role                Role               @default(CUSTOMER)
  status              UserStatus         @default(ACTIVE)
  // Verified identity links (Phase 1 Firebase phone OTP). Nullable so existing
  // accounts are unaffected; set only from server-verified Firebase ID tokens.
  firebaseUid         String?            @unique @map("firebase_uid")
  phoneE164           String?            @unique @map("phone_e164")
  phoneVerifiedAt     DateTime?          @map("phone_verified_at")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  customerProfile     CustomerProfile?
  providerProfile     ProviderProfile?
  userSubscriptions   UserSubscription[]
  payments            Payment[]
  notifications       Notification[]
  messages            Message[]
  userSessions        UserSession[]
  requirementHistories RequirementHistory[]
  requirementNotes     RequirementNote[]
  quotationNegotiations QuotationNegotiation[]
  quotationHistories    QuotationHistory[]
  projectResources      ProjectResource[]
  progressLogs          ProgressLog[]
  projectDocuments      ProjectDocument[]
  projectApprovals      ProjectApproval[]
  projectTimelines      ProjectTimeline[]
  reminders             ReminderQueue[]
  readReceipts          ReadReceipt[]
  messageReactions      MessageReaction[]
  presence              UserPresence?
  globalActivities      GlobalActivity[]
  announcements         Announcement[]

  @@map("users")
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@map("user_sessions")
}


model CustomerProfile {
  id              String             @id @default(uuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String             @map("full_name")
  phoneNumber     String             @map("phone_number")
  address         String?
  city            String
  state           String
  pincode         String
  profileImageUrl String?            @map("profile_image_url")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  bookings        Booking[]
  consultations   ConsultationBooking[]
  favorites       Favorite[]
  reviews         Review[]
  requirements    Requirement[]
  conversations   Conversation[]
  projects        Project[]
  appointments    Appointment[]

  @@map("customer_profiles")
}

model ProviderProfile {
  id                     String               @id @default(uuid())
  userId                 String               @unique
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName               String               @map("full_name")
  businessName           String?              @map("business_name")
  profileImage           String?              @map("profile_image")
  coverImage             String?              @map("cover_image")
  description            String?
  experienceYears        Int                  @map("experience_years")
  city                   String
  state                  String
  serviceAreas           String?              @map("service_areas")
  categoryId             Int                  @map("category_id")
  category               ServiceCategory      @relation(fields: [categoryId], references: [id])
  phoneNumber            String               @map("phone_number")
  email                  String
  verificationStatus     VerificationStatus   @default(PENDING) @map("verification_status")
  averageRating          Float                @default(0.0) @map("average_rating")
  totalReviews           Int                  @default(0) @map("total_reviews")
  rating1Count           Int                  @default(0) @map("rating_1_count")
  rating2Count           Int                  @default(0) @map("rating_2_count")
  rating3Count           Int                  @default(0) @map("rating_3_count")
  rating4Count           Int                  @default(0) @map("rating_4_count")
  rating5Count           Int                  @default(0) @map("rating_5_count")
  totalBookings          Int                  @default(0) @map("total_bookings")
  isAvailable            Boolean              @default(true) @map("is_available")
  isFeatured             Boolean              @default(false) @map("is_featured")

  // Capabilities & Consultation Info
  canProvideServices     Boolean              @default(true) @map("can_provide_services")
  canProvideConsultation Boolean              @default(false) @map("can_provide_consultation")
  consultationFee        Float                @default(0.0) @map("consultation_fee")
  totalConsultations     Int                  @default(0) @map("total_consultations")

  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  bookings               Booking[]
  consultations          ConsultationBooking[]
  consultationAvailabilities ConsultationAvailability[]
  portfolios             Portfolio[]
  favorites              Favorite[]
  reviews                Review[]
  callbackRequests       CallbackRequest[]
  articles               Article[]
  conversations          Conversation[]
  blockedDates           BlockedDate[]
  quotations             Quotation[]
  projects               Project[]
  appointments           Appointment[]
  availabilityBlocks     AvailabilityBlock[]

  @@index([city])
  @@index([categoryId])
  @@index([verificationStatus])
  @@index([isFeatured])
  @@index([averageRating])
  @@map("provider_profiles")
}

enum CategoryType {
  BLUE_COLLAR
  WHITE_COLLAR
}

model ServiceCategory {
  id            Int                   @id @default(autoincrement())
  name          String                @unique
  slug          String                @unique
  categoryType  CategoryType          @map("category_type")
  description   String?
  imageUrl      String?               @map("image_url")
  icon          String?
  parentId      Int?                  @map("parent_id")
  parent        ServiceCategory?      @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children      ServiceCategory[]     @relation("CategoryHierarchy")
  isActive      Boolean               @default(true) @map("is_active")
  isFeatured    Boolean               @default(false) @map("is_featured")
  displayOrder  Int                   @default(0) @map("display_order")
  deletedAt     DateTime?             @map("deleted_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  workforceTypeId String?             @map("workforce_type_id")
  workforceType   WorkforceType?      @relation(fields: [workforceTypeId], references: [id], onDelete: SetNull)

  bookings      Booking[]
  providers     ProviderProfile[]
  callbackRequests CallbackRequest[]
  requirements  Requirement[]

  @@index([parentId])
  @@index([isActive])
  @@index([isFeatured])
  @@map("service_categories")
}

model Booking {
  id              String          @id @default(uuid())
  customerId      String          @map("customer_id")
  customer        CustomerProfile @relation(fields: [customerId], references: [id])
  providerId      String          @map("provider_id")
  provider        ProviderProfile @relation(fields: [providerId], references: [id])
  categoryId      Int             @map("category_id")
  category        ServiceCategory @relation(fields: [categoryId], references: [id])
  bookingNumber   String          @unique @map("booking_number")
  bookingStatus   BookingStatus   @default(REQUESTED) @map("booking_status")
  preferredDate   DateTime        @map("preferred_date")
  preferredTime   String          @map("preferred_time")
  customerAddress String          @map("customer_address")
  city            String
  state           String
  notes           String?
  estimatedBudget Float?          @map("estimated_budget")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  review          Review?
  conversation    Conversation?

  @@map("bookings")
}

enum ConsultationStatus {
  REQUESTED
  ACCEPTED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

model ConsultationAvailability {
  id          String          @id @default(uuid())
  providerId  String          @map("provider_id")
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  dayOfWeek   Int             @map("day_of_week") // 0 = Sunday, 6 = Saturday
  startTime   String          @map("start_time")  // e.g. "09:00"
  endTime     String          @map("end_time")    // e.g. "17:00"
  isAvailable Boolean         @default(true)      @map("is_available")
  createdAt   DateTime        @default(now())     @map("created_at")
  updatedAt   DateTime        @updatedAt          @map("updated_at")

  @@map("consultation_availabilities")
}

model ConsultationBooking {
  id                String             @id @default(uuid())
  bookingNumber     String             @unique @map("booking_number")
  customerId        String             @map("customer_id")
  customer          CustomerProfile    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  providerId        String             @map("provider_id")
  provider          ProviderProfile    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  consultationTopic String             @map("consultation_topic")
  consultationType  String             @map("consultation_type")
  scheduledDate     DateTime           @map("scheduled_date")
  scheduledTime     String             @map("scheduled_time")
  durationMinutes   Int                @map("duration_minutes")
  customerNotes     String?            @map("customer_notes")
  providerNotes     String?            @map("provider_notes")
  meetingLink       String?            @map("meeting_link")
  status            ConsultationStatus @default(REQUESTED)
  createdAt         DateTime           @default(now())           @map("created_at")
  updatedAt         DateTime           @updatedAt                @map("updated_at")
  review            Review?
  conversation      Conversation?

  @@map("consultation_bookings")
}

model SubscriptionPlan {
  id           Int                @id @default(autoincrement())
  name         String
  price        Float
  durationDays Int                @map("duration_days")
  description  String?
  features     Json?
  isActive     Boolean            @default(true) @map("is_active")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  subscriptions UserSubscription[]
  payments      Payment[]

  @@map("subscription_plans")
}

model UserSubscription {
  id                   String             @id @default(uuid())
  userId               String             @map("user_id")
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId               Int                @map("plan_id")
  plan                 SubscriptionPlan   @relation(fields: [planId], references: [id])
  status               SubscriptionStatus @default(ACTIVE)
  startDate            DateTime           @default(now()) @map("start_date")
  endDate              DateTime           @map("end_date")
  transactionReference String?            @map("transaction_reference")
  createdAt            DateTime           @default(now()) @map("created_at")

  @@map("user_subscriptions")
}

model Payment {
  id                String            @id @default(uuid())
  userId            String            @map("user_id")
  user              User              @relation(fields: [userId], references: [id])
  amount            Float
  paymentType       PaymentType       @map("payment_type")
  status            PaymentStatus     @default(PENDING)
  txRef             String            @unique @map("tx_ref")
  createdAt         DateTime          @default(now())
  razorpayOrderId   String?           @map("razorpay_order_id")
  razorpayPaymentId String?           @map("razorpay_payment_id")
  razorpaySignature String?           @map("razorpay_signature")
  planId            Int?              @map("plan_id")
  plan              SubscriptionPlan? @relation(fields: [planId], references: [id])

  @@map("payments")
}

model Review {
  id                    String              @id @default(uuid())
  customerId            String              @map("customer_id")
  customer              CustomerProfile     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  providerId            String              @map("provider_id")
  provider              ProviderProfile     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  bookingId             String?             @unique @map("booking_id")
  booking               Booking?            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  consultationBookingId String?             @unique @map("consultation_booking_id")
  consultationBooking   ConsultationBooking? @relation(fields: [consultationBookingId], references: [id], onDelete: Cascade)
  rating                Int
  reviewTitle           String              @map("review_title")
  reviewDescription     String              @map("review_description")
  wouldRecommend        Boolean             @default(true) @map("would_recommend")
  providerResponse      String?             @map("provider_response")
  isVerified            Boolean             @default(false) @map("is_verified")
  isVisible             Boolean             @default(true) @map("is_visible")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  @@map("reviews")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now())

  @@map("notifications")
}

model Favorite {
  id         String          @id @default(uuid())
  customerId String          @map("customer_id")
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  providerId String?         @map("provider_id")
  provider   ProviderProfile? @relation(fields: [providerId], references: [id])
  createdAt  DateTime        @default(now())

  @@map("favorites")
}

model Portfolio {
  id           String          @id @default(uuid())
  providerId   String?         @map("provider_id")
  provider     ProviderProfile? @relation(fields: [providerId], references: [id])
  title        String
  description  String
  projectType  String          @map("project_type")
  imageUrl     String?         @map("image_url")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("portfolios")
}

model BlogCategory {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  articles    Article[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("blog_categories")
}

model Article {
  id                      String           @id @default(uuid())
  title                   String
  slug                    String           @unique
  excerpt                 String
  content                 String
  featuredImage           String?          @map("featured_image")
  authorProviderId        String?          @map("author_provider_id")
  authorProvider          ProviderProfile? @relation(fields: [authorProviderId], references: [id])
  categoryId              Int              @map("category_id")
  category                BlogCategory     @relation(fields: [categoryId], references: [id])
  tags                    String           @default("")
  readTime                Int              @default(5) @map("read_time")
  isPublished             Boolean          @default(false) @map("is_published")
  publishedAt             DateTime?        @map("published_at")
  seoTitle                String?          @map("seo_title")
  seoDescription          String?          @map("seo_description")
  
  // Analytics
  viewsCount              Int              @default(0) @map("views_count")
  totalReadingTime        Int              @default(0) @map("total_reading_time")
  consultationConversions Int              @default(0) @map("consultation_conversions")
  callbackConversions     Int              @default(0) @map("callback_conversions")

  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")

  @@map("articles")
}

enum RequirementStatus {
  DRAFT
  SUBMITTED
  PUBLISHED
  PROVIDER_REVIEW
  QUOTATION_RECEIVED
  CUSTOMER_REVIEW
  QUOTATION_ACCEPTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED
  REJECTED
  EXPIRED
  ON_HOLD
}

model Requirement {
  id                  Int                     @id @default(autoincrement())
  customerId          String                  @map("customer_id")
  customer            CustomerProfile         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title               String
  description         String
  serviceCategory     String                  @map("service_category")
  serviceCategoryId   Int?                    @map("service_category_id")
  serviceCategoryRel  ServiceCategory?        @relation(fields: [serviceCategoryId], references: [id])
  location            String
  budgetMin           Float                   @map("budget_min")
  budgetMax           Float                   @map("budget_max")
  preferredStartDate  DateTime?               @map("preferred_start_date")
  status              RequirementStatus       @default(DRAFT)
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  attachments         RequirementAttachment[]
  history             RequirementHistory[]
  notes               RequirementNote[]
  quotations          Quotation[]
  project             Project?
  appointments        Appointment[]
  conversations       Conversation[]

  @@index([customerId])
  @@index([serviceCategoryId])
  @@index([status])
  @@index([location])
  @@index([createdAt])
  @@map("requirements")
}

model RequirementAttachment {
  id            Int         @id @default(autoincrement())
  requirementId Int         @map("requirement_id")
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  fileName      String      @map("file_name")
  fileUrl       String      @map("file_url")
  fileType      String      @map("file_type")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("requirement_attachments")
}

model RequirementHistory {
  id            Int         @id @default(autoincrement())
  requirementId Int         @map("requirement_id")
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  fromStatus    String?     @map("from_status")
  toStatus      String      @map("to_status")
  changedById   String      @map("changed_by_id")
  changedBy     User        @relation(fields: [changedById], references: [id])
  changeReason  String?     @map("change_reason")
  previousValues String?    @map("previous_values")
  newValues     String?     @map("new_values")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("requirement_histories")
}

model RequirementNote {
  id            Int         @id @default(autoincrement())
  requirementId Int         @map("requirement_id")
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  authorId      String      @map("author_id")
  author        User        @relation(fields: [authorId], references: [id])
  content       String
  isPrivate     Boolean     @default(false) @map("is_private")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("requirement_notes")
}

enum CallbackStatus {
  NEW
  ASSIGNED
  CONTACTED
  CONSULTATION_BOOKED
  SERVICE_BOOKED
  CLOSED
  CANCELLED
}

model CallbackRequest {
  id                 String          @id @default(uuid())
  referenceNumber    String          @unique @map("reference_number")
  fullName           String          @map("full_name")
  phoneNumber        String          @map("phone_number")
  email              String?
  city               String
  state              String
  preferredLanguage  String          @map("preferred_language")
  serviceCategoryId  Int?            @map("service_category_id")
  category           ServiceCategory? @relation(fields: [serviceCategoryId], references: [id])
  projectType        String          @map("project_type")
  estimatedBudget    Float?          @map("estimated_budget")
  preferredCallTime  String          @map("preferred_call_time")
  message            String
  status             CallbackStatus  @default(NEW)
  assignedProviderId String?         @map("assigned_provider_id")
  provider           ProviderProfile? @relation(fields: [assignedProviderId], references: [id])
  assignedAdminId    String?         @map("assigned_admin_id")
  callbackDate       DateTime?       @map("callback_date")
  callbackTime       String?         @map("callback_time")
  notes              String?
  source             String          @default("Website")
  createdAt          DateTime        @default(now())         @map("created_at")
  updatedAt          DateTime        @updatedAt             @map("updated_at")

  @@map("callback_requests")
}

model Conversation {
  id                    String              @id @default(uuid())
  bookingId             String?             @unique @map("booking_id")
  booking               Booking?            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  consultationBookingId String?             @unique @map("consultation_booking_id")
  consultationBooking   ConsultationBooking? @relation(fields: [consultationBookingId], references: [id], onDelete: Cascade)
  customerId            String              @map("customer_id")
  customer              CustomerProfile     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  providerId            String              @map("provider_id")
  provider              ProviderProfile     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  
  conversationType      String              @default("DIRECT") @map("conversation_type") // DIRECT, GROUP, REQUIREMENT, QUOTATION, PROJECT, WORK_ORDER, APPOINTMENT, SUPPORT, TEAM, ANNOUNCEMENT
  requirementId         Int?                @map("requirement_id")
  requirement           Requirement?        @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  projectId             String?             @map("project_id")
  project               Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)

  lastMessage           String?             @map("last_message")
  lastMessageAt         DateTime?           @map("last_message_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  messages              Message[]

  @@map("conversations")
}

model Message {
  id             String            @id @default(uuid())
  conversationId String            @map("conversation_id")
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String            @map("sender_id")
  sender         User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  messageType    String            @default("TEXT") @map("message_type") // TEXT, IMAGE, FILE, SYSTEM
  content        String
  attachmentUrl  String?           @map("attachment_url")
  isRead         Boolean           @default(false) @map("is_read")
  isEdited       Boolean           @default(false) @map("is_edited")
  isDeleted      Boolean           @default(false) @map("is_deleted")
  threadId       String?           @map("thread_id")
  createdAt      DateTime          @default(now()) @map("created_at")

  readReceipts   ReadReceipt[]
  reactions      MessageReaction[]

  @@map("messages")
}

model BlockedDate {
  id          String          @id @default(uuid())
  providerId  String          @map("provider_id")
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  date        DateTime
  reason      String?
  createdAt   DateTime        @default(now()) @map("created_at")

  @@map("provider_blocked_dates")
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  VIEWED
  UNDER_REVIEW
  NEGOTIATION
  REVISED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
  ARCHIVED
}

enum PricingModel {
  FIXED
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  MILESTONE_BASED
  CUSTOM
}

model Quotation {
  id                    Int                   @id @default(autoincrement())
  requirementId         Int                   @map("requirement_id")
  requirement           Requirement           @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  providerId            String                @map("provider_id")
  provider              ProviderProfile       @relation(fields: [providerId], references: [id])
  status                QuotationStatus       @default(DRAFT)
  priceModel            PricingModel          @default(FIXED)
  totalAmount           Float                 @map("total_amount")
  estimatedDurationDays Int                   @map("estimated_duration_days")
  warrantyMonths        Int?                  @map("warranty_months")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  proposal              Proposal?
  milestones            QuotationMilestone[]
  negotiations          QuotationNegotiation[]
  attachments           QuotationAttachment[]
  history               QuotationHistory[]
  project               Project?

  @@index([requirementId])
  @@index([providerId])
  @@index([status])
  @@index([createdAt])
  @@map("quotations")
}

model Proposal {
  id            Int         @id @default(autoincrement())
  quotationId   Int         @unique @map("quotation_id")
  quotation     Quotation   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  title         String
  summary       String
  scope         String
  deliverables  String
  assumptions   String?
  exclusions    String?
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("proposals")
}

model QuotationMilestone {
  id            Int         @id @default(autoincrement())
  quotationId   Int         @map("quotation_id")
  quotation     Quotation   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  cost          Float
  durationDays  Int?        @map("duration_days")
  dueAt         DateTime?   @map("due_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("quotation_milestones")
}

model QuotationNegotiation {
  id            Int         @id @default(autoincrement())
  quotationId   Int         @map("quotation_id")
  quotation     Quotation   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  senderId      String      @map("sender_id")
  sender        User        @relation(fields: [senderId], references: [id])
  counterAmount Float?      @map("counter_amount")
  comment       String
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("quotation_negotiations")
}

model QuotationAttachment {
  id            Int         @id @default(autoincrement())
  quotationId   Int         @map("quotation_id")
  quotation     Quotation   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  fileName      String      @map("file_name")
  fileUrl       String      @map("file_url")
  fileType      String      @map("file_type")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("quotation_attachments")
}

model QuotationHistory {
  id            Int         @id @default(autoincrement())
  quotationId   Int         @map("quotation_id")
  quotation     Quotation   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  version       Int
  fromStatus    String?     @map("from_status")
  toStatus      String      @map("to_status")
  changedById   String      @map("changed_by_id")
  changedBy     User        @relation(fields: [changedById], references: [id])
  changeReason  String?     @map("change_reason")
  previousValues String?
  newValues     String?
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("quotation_histories")
}

enum ProjectStatus {
  CREATED
  ASSIGNED
  PLANNING
  READY_TO_START
  IN_PROGRESS
  ON_HOLD
  BLOCKED
  UNDER_REVIEW
  COMPLETED
  CUSTOMER_APPROVAL
  CLOSED
  ARCHIVED
  CANCELLED
  SUSPENDED
  DELAYED
  REOPENED
}

model Project {
  id            String            @id @default(uuid())
  requirementId Int               @unique @map("requirement_id")
  requirement   Requirement       @relation(fields: [requirementId], references: [id])
  customerId    String            @map("customer_id")
  customer      CustomerProfile   @relation(fields: [customerId], references: [id])
  providerId    String            @map("provider_id")
  provider      ProviderProfile   @relation(fields: [providerId], references: [id])
  quotationId   Int               @unique @map("quotation_id")
  quotation     Quotation         @relation(fields: [quotationId], references: [id])
  status        ProjectStatus     @default(CREATED)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  phases        ProjectPhase[]
  milestones    ProjectMilestone[]
  workOrders    WorkOrder[]
  resources     ProjectResource[]
  progressLogs  ProgressLog[]
  documents     ProjectDocument[]
  approvals     ProjectApproval[]
  timeline      ProjectTimeline[]
  appointments  Appointment[]
  conversations Conversation[]

  @@index([providerId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("projects")
}

model ProjectPhase {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("project_phases")
}

model ProjectMilestone {
  id                  String      @id @default(uuid())
  projectId           String      @map("project_id")
  project             Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  plannedStart        DateTime?   @map("planned_start")
  plannedEnd          DateTime?   @map("planned_end")
  actualStart         DateTime?   @map("actual_start")
  actualEnd           DateTime?   @map("actual_end")
  budgetAllocation    Float       @default(0.0) @map("budget_allocation")
  completionPercentage Float       @default(0.0) @map("completion_percentage")
  status              String      @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, APPROVED
  createdAt           DateTime    @default(now()) @map("created_at")

  workOrders          WorkOrder[]

  @@map("project_milestones")
}

model WorkOrder {
  id                  String            @id @default(uuid())
  projectId           String            @map("project_id")
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId         String?           @map("milestone_id")
  milestone           ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title               String
  description         String?
  priority            String            @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status              String            @default("TODO") // TODO, IN_PROGRESS, REVIEW, DONE, BLOCKED
  dueDate             DateTime?         @map("due_date")
  estimatedHours      Float?            @map("estimated_hours")
  actualHours         Float?            @map("actual_hours")
  dependencies        String?
  completionNotes     String?           @map("completion_notes")
  assignedResourceId  String?           @map("assigned_resource_id")
  assignedResource    ProjectResource?  @relation(fields: [assignedResourceId], references: [id], onDelete: SetNull)
  createdAt           DateTime          @default(now()) @map("created_at")

  @@map("work_orders")
}

model ProjectResource {
  id          String      @id @default(uuid())
  projectId   String      @map("project_id")
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id])
  role        String      @default("WORKER") // WORKER, CONTRACTOR, CONSULTANT, SUPERVISOR
  assignedAt  DateTime    @default(now()) @map("assigned_at")

  workOrders  WorkOrder[]

  @@map("project_resources")
}

model ProgressLog {
  id                  String    @id @default(uuid())
  projectId           String    @map("project_id")
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporterId          String    @map("reporter_id")
  reporter            User      @relation(fields: [reporterId], references: [id])
  completionPercentage Float     @map("completion_percentage")
  notes               String
  evidenceUrl         String?   @map("evidence_url")
  reportType          String    @default("DAILY") // DAILY, WEEKLY
  createdAt           DateTime  @default(now()) @map("created_at")

  @@map("project_progress_logs")
}

model ProjectDocument {
  id            String    @id @default(uuid())
  projectId     String    @map("project_id")
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  fileUrl       String    @map("file_url")
  fileType      String    @map("file_type")
  uploadedById  String    @map("uploaded_by_id")
  uploadedBy    User      @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("project_documents")
}

model ProjectApproval {
  id              String    @id @default(uuid())
  projectId       String    @map("project_id")
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approverId      String    @map("approver_id")
  approver        User      @relation(fields: [approverId], references: [id])
  targetType      String    @map("target_type") // PROJECT_START, MILESTONE, WORK_ORDER, CHANGE_REQUEST, PROJECT_COMPLETION
  targetId        String    @map("target_id")
  status          String    @default("PENDING")
  rejectionReason String?   @map("rejection_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("project_approvals")
}

model ProjectTimeline {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId     String   @map("actor_id")
  actor       User     @relation(fields: [actorId], references: [id])
  eventType   String   @map("event_type")
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("project_timelines")
}

enum AppointmentStatus {
  DRAFT
  SCHEDULED
  PENDING_CONFIRMATION
  CONFIRMED
  REMINDER_SENT
  IN_PROGRESS
  COMPLETED
  ARCHIVED
  CANCELLED
  RESCHEDULED
  NO_SHOW
  EXPIRED
  REJECTED
}

model Appointment {
  id            String            @id @default(uuid())
  title         String
  description   String?
  eventType     String            @default("CONSULTATION") // CONSULTATION, SITE_VISIT, INSPECTION, PROGRESS_REVIEW
  status        AppointmentStatus @default(PENDING_CONFIRMATION)
  startTime     DateTime          @map("start_time")
  endTime       DateTime          @map("end_time")
  
  customerId    String?           @map("customer_id")
  customer      CustomerProfile?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  providerId    String?           @map("provider_id")
  provider      ProviderProfile?  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  projectId     String?           @map("project_id")
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirementId Int?              @map("requirement_id")
  requirement   Requirement?      @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  
  meetingLink   String?           @map("meeting_link")
  notes         String?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  resources     AppointmentResource[]
  reminders     ReminderQueue[]

  @@index([providerId])
  @@index([customerId])
  @@index([startTime])
  @@index([status])
  @@index([eventType])
  @@map("appointments")
}

model AppointmentResource {
  id            String      @id @default(uuid())
  appointmentId String      @map("appointment_id")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  resourceName  String      @map("resource_name")
  resourceType  String      @map("resource_type") // ROOM, VEHICLE, TOOL, EQUIPMENT
  quantity      Int         @default(1)
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("appointment_resources")
}

model ReminderQueue {
  id                String      @id @default(uuid())
  appointmentId     String      @map("appointment_id")
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  recipientId       String      @map("recipient_id")
  recipient         User        @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  reminderType      String      @default("EMAIL") // EMAIL, SMS, PUSH
  scheduledSendTime DateTime    @map("scheduled_send_time")
  sentAt            DateTime?   @map("sent_at")
  status            String      @default("PENDING") // PENDING, SENT, FAILED
  createdAt         DateTime    @default(now()) @map("created_at")

  @@map("reminder_queues")
}

model AvailabilityBlock {
  id          String          @id @default(uuid())
  providerId  String          @map("provider_id")
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  dayOfWeek   Int             // 0 (Sunday) to 6 (Saturday)
  startTime   String          @map("start_time") // "09:00"
  endTime     String          @map("end_time") // "17:00"
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@map("availability_blocks")
}

model ReadReceipt {
  id             String      @id @default(uuid())
  messageId      String      @map("message_id")
  message        Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId         String      @map("user_id")
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime    @default(now()) @map("read_at")

  @@map("read_receipts")
}

model MessageReaction {
  id             String      @id @default(uuid())
  messageId      String      @map("message_id")
  message        Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId         String      @map("user_id")
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reaction       String
  createdAt      DateTime    @default(now()) @map("created_at")

  @@map("message_reactions")
}

model UserPresence {
  id             String      @id @default(uuid())
  userId         String      @unique @map("user_id")
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         String      @default("ONLINE") // ONLINE, OFFLINE, AWAY, BUSY
  lastSeenAt     DateTime    @default(now()) @map("last_seen_at")

  @@map("user_presences")
}

model GlobalActivity {
  id             String      @id @default(uuid())
  actorId        String      @map("actor_id")
  actor          User        @relation(fields: [actorId], references: [id], onDelete: Cascade)
  activityType   String      @map("activity_type")
  description    String      @db.Text
  targetType     String?     @map("target_type")
  targetId       String?     @map("target_id")
  createdAt      DateTime    @default(now()) @map("created_at")

  @@map("global_activities")
}

model Announcement {
  id             String      @id @default(uuid())
  title          String
  content        String      @db.Text
  authorId       String      @map("author_id")
  author         User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now()) @map("created_at")

  @@map("announcements")
}

model WorkforceType {
  id          String            @id @default(uuid())
  name        String            @unique // "BLUE_COLLAR", "WHITE_COLLAR", "GREY_COLLAR"
  displayName String            @map("display_name") // "Blue Collar", "White Collar"
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  categories  ServiceCategory[]

  @@map("workforce_types")
}
